# Copy to .env and run: chmod 600 .env   (.env is git-ignored)

# --- AI: deepseek or qwen (both OpenAI-compatible) ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional overrides. Qwen mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL=
# LLM_MODEL=

# --- Exchange keys: only needed for risk.mode = "live" ---
# Create keys with TRADE permission only: withdrawals OFF, IP whitelist ON.
# Pattern: EXCHANGE_<ccxt id>_API_KEY / _SECRET / _PASSWORD (OKX/KuCoin need a passphrase)
# EXCHANGE_OKX_API_KEY=
# EXCHANGE_OKX_SECRET=
# EXCHANGE_OKX_PASSWORD=
# EXCHANGE_BINANCE_API_KEY=
# EXCHANGE_BINANCE_SECRET=
