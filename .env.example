# Copy to .env and run: chmod 600 .env   (.env is git-ignored)
# Recommended: keep real keys in the encrypted vault instead of this file:
#   python -m arbdesk vault init
#   python -m arbdesk vault set LLM_API_KEY
#   python -m arbdesk vault import-env      (moves keys from .env into the vault)

# --- AI: deepseek or qwen (both OpenAI-compatible) ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional overrides. Qwen mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL=
# LLM_MODEL=

# --- Exchange keys: only needed for risk.mode = "live" ---
# Create keys with TRADE permission only: withdrawals OFF, IP whitelist ON.
# Pattern: EXCHANGE_<ccxt id>_API_KEY / _SECRET / _PASSWORD (OKX/KuCoin need a passphrase)
# EXCHANGE_OKX_API_KEY=
# EXCHANGE_OKX_SECRET=
# EXCHANGE_OKX_PASSWORD=
# EXCHANGE_BINANCE_API_KEY=
# EXCHANGE_BINANCE_SECRET=

# --- Polymarket wallet ---
# POLYMARKET_PRIVATE_KEY is accepted ONLY from the vault (ignored here):
#   python -m arbdesk vault set POLYMARKET_PRIVATE_KEY
# Non-secret wallet settings may live here or in the vault:
# POLYMARKET_FUNDER=0x...           # wallet address shown on polymarket.com (proxy/Safe)
# POLYMARKET_SIGNATURE_TYPE=1       # 0 EOA, 1 email/Magic login, 2 browser wallet (Safe)

# --- Kalshi / Polymarket US (US residents) ---
# Private keys are accepted ONLY from the vault:
#   python -m arbdesk vault set KALSHI_API_KEY_ID
#   python -m arbdesk vault set-file KALSHI_PRIVATE_KEY C:/path/to/kalshi-key.pem
#   python -m arbdesk vault set POLYMARKET_US_KEY_ID
#   python -m arbdesk vault set POLYMARKET_US_SECRET_KEY
